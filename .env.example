# --- Database (Replit provides this automatically once you add PostgreSQL) ---
DATABASE_URL=postgresql://user:pass@host/db

# --- Session signing (generate: openssl rand -hex 32) ---
SESSION_SECRET=

# --- SMS / OTP ---
# VALIDATE DELIVERABILITY TO +213 BEFORE BUILDING ON TOP OF THIS.
# If SMS does not deliver, the app still works: unverified posts are allowed
# but ranked below verified ones and cannot claim or reveal contact details.
# Send a verification SMS to people POSTING a request. Off by default: it is
# the donor side that must be verified (seeing an address requires it), and
# requests far outnumber donors, so leaving this off is the main cost lever.
SMS_VERIFY_REQUESTERS=false

SMS_PROVIDER=none           # none | twilio | vonage
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Content screening (Claude Haiku) ---
# If unset, the deterministic blocklist still runs and the LLM pass is skipped.
ANTHROPIC_API_KEY=
SCREENING_MODEL=claude-haiku-4-5-20251001

# --- Operations ---
ADMIN_PASSWORD=             # protects /admin
ABUSE_EMAIL=                # shown publicly as the takedown contact
CLAIM_WINDOW_HOURS=6        # tune this from pilot data
REQUEST_TTL_HOURS=72
